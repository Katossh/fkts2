# Pin to the version already used by the existing fkts deployment.
XRAY_VERSION=26.10.31
CADDY_VERSION=2

# Set true to temporarily use the same public IP for entry and exit.
# Set false when a separate second public IP is configured.
SINGLE_IP_MODE=false

# Both addresses must be configured/routed on the VPS host.
# These TEST-NET values are documentation placeholders, not usable addresses.
ENTRY_IP=192.0.2.10
EXIT_IP=192.0.2.11

# Use the standard HTTPS port. Choose another port only if 443 is occupied
# or you intentionally need a custom listener.
INBOUND_PORT=443

# Cloudflare DNS + Caddy ACME: token needs Zone:Zone:Read and Zone:DNS:Edit.
# Do not commit your real token or zone ID.
CF_API_TOKEN=REPLACE_ME
CF_ZONE_ID=REPLACE_ME
CF_ZONE_NAME=katossh.dpdns.org
CF_RECORD_NAME=xray.katossh.dpdns.org
# Set true only once after reviewing an existing unmanaged A record that fkts2 should own.
# Successful updates add an fkts2 ownership comment; set this back to false afterward.
CF_ALLOW_EXISTING_RECORD_UPDATE=false

# Address placed in the generated client profile; defaults to the DNS name above.
ENTRY_ADDRESS=xray.katossh.dpdns.org

# Self-steal: Xray forwards unauthenticated TLS handshakes to local Caddy.
REALITY_TARGET=127.0.0.1:9443
# Must match the DNS hostname and the Caddy certificate name.
REALITY_SERVER_NAME=xray.katossh.dpdns.org

# Generate with: bash ./scripts/keygen.sh
REALITY_PRIVATE_KEY=REPLACE_ME
REALITY_PUBLIC_KEY=REPLACE_ME

# Generated locally by ./scripts/init.sh; can be rotated later.
CLIENT_UUID=REPLACE_ME
REALITY_SHORT_ID=REPLACE_ME
