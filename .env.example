# Pin to the version already used by the existing fkts deployment.
XRAY_VERSION=26.10.31

# Both addresses must be configured/routed on the VPS host.
# These TEST-NET values are documentation placeholders, not usable addresses.
ENTRY_IP=192.0.2.10
EXIT_IP=192.0.2.11

# Use 8443 while fkts is still serving the existing 443 listener.
# Change to 443 only during a planned cutover.
INBOUND_PORT=8443

# Address placed in the generated client profile (can later be changed to a DNS name).
ENTRY_ADDRESS=192.0.2.10

# REALITY target and SNI must match a real target that accepts this SNI.
REALITY_TARGET=www.example.com:443
REALITY_SERVER_NAME=www.example.com

# Generate with: ./scripts/keygen.sh
REALITY_PRIVATE_KEY=REPLACE_ME
REALITY_PUBLIC_KEY=REPLACE_ME

# Generated locally by ./scripts/init.sh; can be rotated later.
CLIENT_UUID=REPLACE_ME
REALITY_SHORT_ID=REPLACE_ME
